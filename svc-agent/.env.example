# Copy to .env. Gitignored — but note this folder syncs to OneDrive, so a key
# here does reach the tenant. Use Fly secrets in production, not this file.

# Classification. Without it the server still runs, on the stub classifier.
CLAUDE_API_KEY=sk-ant-...

# The first centre's sign-in password (user ID: voltas). Read once, on the
# first boot that finds no centres; after that the hash in accounts.db counts.
ADMIN_PASSWORD=choose-something

# Optional. Signs the portal's 12-hour session cookie; unset, one is generated
# once and kept in accounts.db.
# SESSION_SECRET=

# Agent turns each centre gets per day — every turn can cost a model call.
# ORG_DAILY_TURNS=300

# The /call and /vapi endpoints a voice layer uses. Same rule — unset means refused.
CALL_API_SECRET=choose-something-else

# An unknown number gets a demo customer and car, and the chat panel shows the
# SMS each turn sent. Public demos only — never with real customer data.
DEMO_MODE=true

# The database from before separate centres. Its folder also holds
# accounts.db and orgs/<centre>.db unless DATA_DIR says otherwise.
# DB_PATH=/data/service.db

# PORT=3001

# The centre's clock. Every date the agent offers is a date here, whatever
# timezone the server itself runs in.
# CENTRE_TIMEZONE=Asia/Kolkata

# Set on Fly, where the client's address arrives from the platform proxy.
# BEHIND_PROXY=true
