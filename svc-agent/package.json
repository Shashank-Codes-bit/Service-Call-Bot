{
  "name": "svc-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:rebuild": "tsx src/db/seed.ts",
    "dev": "tsx watch src/dealer/server.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "serve": "tsx src/dealer/server.ts",
    "start": "npm run build:web && npm run serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts",
    "vapi:setup": "tsx src/tools/vapi-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vapi-ai/web": "^2.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
